# Copy to .env.local and fill in. Nothing here is committed with a value.
# Vercel carries the same names on Production (and Preview) — see README.md.

# Enquiries — the Neon connection string. Without it, development writes
# .enquiries.dev.json and production refuses to accept enquiries (loudly).
DATABASE_URL=

# The enquiries desk at /margo-desk. Change both in Vercel and redeploy to
# rotate; changing the session secret signs everyone out.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Read access to GET /api/enquiries (CSV export, automation).
ENQUIRIES_READ_TOKEN=

# Shared with the Sanity webhook that calls /api/revalidate on publish, and
# used by `npm run revalidate`.
SANITY_REVALIDATE_SECRET=

# Only the apply scripts (`--write`) need this. The site reads the public
# dataset with no token.
SANITY_WRITE_TOKEN=

# Enquiry attachments — Margo's Cloudinary account, Settings → API keys →
# "API environment variable".
CLOUDINARY_URL=

# THE LAUNCH SWITCH. Leave unset until www.margorubber.com serves this site, then
# set to `true` on the Vercel production deployment and redeploy: every page
# that is not a Draft becomes indexable (robots, sitemap, JSON-LD). See
# CUTOVER.md §5. Never set it on a preview or the vision build.
NEXT_PUBLIC_SITE_LIVE=

# Enquiry notification email — after the DNS records in
# 23_DNS_Setup_For_Website_Email.md are in place. Optional until then.
RESEND_API_KEY=
ENQUIRY_TO=
ENQUIRY_FROM=

# Optional: a CRM webhook that receives every enquiry as JSON.
WEBHOOK_URL=

# Leave unset on the public site. "vision" builds the password-gated concept
# preview (PREVIEW_USER / PREVIEW_PASSWORD, noindex everywhere).
NEXT_PUBLIC_BUILD_MODE=
